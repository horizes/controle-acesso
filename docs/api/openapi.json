  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "gatewayToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token exclusivo acgw_ do gateway"
      },
      "gatewayHmac": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Gateway-Signature",
        "description": "Hex HMAC-SHA256 sobre POST + newline + caminho lógico + newline + corpo original; chave = token do gateway"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "desk",
              "resident"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "role",
          "name",
          "email"
        ],
        "additionalProperties": false
      },
      "Resident": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "initials": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "unit",
          "initials"
        ],
        "additionalProperties": false
      },
      "Visit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "host": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "Visitante",
              "Prestador",
              "Entrega"
            ]
          },
          "status": {
            "enum": [
              "Aguardando",
              "Autorizado",
              "No condomínio",
              "Finalizado",
              "Recusado"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          },
          "known": {
            "type": "boolean"
          },
          "enteredAt": {
            "type": "string",
            "format": "date-time"
          },
          "exitedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
