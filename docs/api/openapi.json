{
  "openapi": "3.1.0",
  "info": {
    "title": "Imperium Controle de Acesso",
    "version": "2.0.0",
    "description": "API implantada. Autenticação própria Supabase Auth e gateway HMAC; equipamentos exigem homologação."
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/v1/auth/login": {
      "post": {
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role": {
                    "enum": [
                      "desk",
                      "resident"
                    ]
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "role",
                  "email",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resposta autorizada para o usuário",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": {
                      "type": "string",
                      "minLength": 16
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  },
                  "required": [
                    "accessToken",
                    "expiresAt",
                    "user"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Sessão inválida ou expirada"
          },
          "403": {
            "description": "Perfil ou unidade sem permissão"
          },
          "409": {
            "description": "Conflito de estado ou idempotência"
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Sessão revogada"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Sessão inválida ou expirada"
          },
          "403": {
            "description": "Perfil ou unidade sem permissão"
          },
          "409": {
            "description": "Conflito de estado ou idempotência"
          }
        }
      }
    },
    "/v1/state": {
      "get": {
        "responses": {
