{
  "name": "controle-acesso",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "node scripts/check-demo.mjs && node scripts/check-integration.mjs",
    "test:integration": "node scripts/check-integration.mjs",
    "build:server": "node scripts/build-server.mjs",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "gateway": "node gateway/run.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node --import ./scripts/windows-fs-compat.mjs ./node_modules/vite/bin/vite.js build --outDir docs && node scripts/build-pwa.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "typescript": "5.9.3",
    "esbuild": "0.28.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19"
  }
}
