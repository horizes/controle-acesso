                "required": [
                  "name",
                  "unit",
                  "carrier",
                  "tracking",
                  "location",
                  "volumes"
                ],
                "additionalProperties": false
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "type",
              "payload",
              "requestId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "parcel.withdraw"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "receivedBy": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "receivedBy"
                ],
                "additionalProperties": false
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "type",
              "payload",
              "requestId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "invite.create"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "host": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "enum": [
                      "Visita",
                      "Serviço"
                    ]
                  },
                  "startsAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "endsAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "plate": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "unit",
                  "host",
                  "type",
                  "startsAt",
                  "endsAt"
                ],
                "additionalProperties": false
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "type",
              "payload",
              "requestId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "invite.cancel"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "type",
              "payload",
              "requestId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "booking.create"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "area": {
                    "type": "string",
                    "minLength": 1
                  },
                  "startsAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "endsAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "area",
                  "startsAt",
                  "endsAt"
                ],
                "additionalProperties": false
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "type",
              "payload",
              "requestId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "booking.cancel"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "type",
              "payload",
              "requestId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "request.create"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "subject",
                  "message"
                ],
                "additionalProperties": false
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "type",
              "payload",
              "requestId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "request.resolve"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "type",
              "payload",
              "requestId"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
