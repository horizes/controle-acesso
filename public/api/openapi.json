          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "enum": [
              "visit",
              "parcel",
              "invite",
              "access",
              "booking",
              "request"
            ]
          },
          "allowed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "detail",
          "at",
          "kind"
        ],
        "additionalProperties": false
      },
      "State": {
        "type": "object",
        "properties": {
          "version": {
            "const": 2
          },
          "residents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Resident"
            }
          },
          "visits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Visit"
            }
          },
          "parcels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Parcel"
            }
          },
          "invites": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Invite"
            }
          },
          "credentials": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Credential"
            }
          },
          "bookings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Booking"
            }
          },
          "requests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Request"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          }
        },
        "required": [
          "version",
          "residents",
          "visits",
          "parcels",
          "invites",
          "credentials",
          "bookings",
          "requests",
          "events"
        ],
        "additionalProperties": false
      },
      "Command": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "visit.create"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "host": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "enum": [
                      "Visitante",
                      "Prestador",
                      "Entrega"
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "unit",
                  "host",
                  "type",
                  "note"
                ],
                "additionalProperties": false
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "type",
              "payload",
              "requestId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "visit.transition"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "Autorizado",
                      "Recusado",
                      "No condomínio",
                      "Finalizado"
                    ]
                  }
                },
                "required": [
                  "id",
                  "status"
                ],
                "additionalProperties": false
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "type",
              "payload",
              "requestId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "parcel.receive"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "carrier": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tracking": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string",
                    "minLength": 1
                  },
                  "volumes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 99
                  }
