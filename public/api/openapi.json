          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "resolved": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "unit",
          "subject",
          "message",
          "at",
          "resolved"
        ],
        "additionalProperties": false
      },
      "Event": {
        "type": "object",
