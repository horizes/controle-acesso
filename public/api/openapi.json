{
  "openapi": "3.1.0",
  "info": {
    "title": "Imperium Controle de Acesso — contrato da API futura",
    "version": "1.0.0",
    "description": "Este contrato não representa um servidor implantado. A hospedagem atual é somente GitHub Pages."
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/v1/auth/login": {
      "post": {
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role": {
                    "enum": [
                      "desk",
                      "resident"
                    ]
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "role",
                  "email",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resposta autorizada para o usuário",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": {
                      "type": "string",
                      "minLength": 16
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  },
                  "required": [
                    "accessToken",
                    "expiresAt",
                    "user"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Sessão inválida ou expirada"
          },
          "403": {
            "description": "Perfil ou unidade sem permissão"
          },
          "409": {
            "description": "Conflito de estado ou idempotência"
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Sessão revogada"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Sessão inválida ou expirada"
          },
          "403": {
            "description": "Perfil ou unidade sem permissão"
          },
          "409": {
            "description": "Conflito de estado ou idempotência"
          }
        }
      }
    },
    "/v1/state": {
      "get": {
        "responses": {
          "200": {
            "description": "Resposta autorizada para o usuário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/State"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Sessão inválida ou expirada"
          },
          "403": {
            "description": "Perfil ou unidade sem permissão"
          },
          "409": {
            "description": "Conflito de estado ou idempotência"
          }
        }
      }
    },
    "/v1/commands": {
      "post": {
        "description": "O servidor valida perfil, unidade, concorrência e idempotência. Nunca aceita estado de autorização pronto do navegador.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resposta autorizada para o usuário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/State"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Sessão inválida ou expirada"
          },
          "403": {
            "description": "Perfil ou unidade sem permissão"
          },
          "409": {
            "description": "Conflito de estado ou idempotência"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "desk",
              "resident"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "role",
          "name",
          "email"
        ],
        "additionalProperties": false
      },
      "Resident": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "initials": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "unit",
          "initials"
        ],
        "additionalProperties": false
      },
      "Visit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "host": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "Visitante",
              "Prestador",
              "Entrega"
            ]
          },
          "status": {
            "enum": [
              "Aguardando",
              "Autorizado",
              "No condomínio",
              "Finalizado",
              "Recusado"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          },
          "known": {
            "type": "boolean"
          },
          "enteredAt": {
            "type": "string",
            "format": "date-time"
          },
          "exitedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "unit",
          "host",
          "type",
          "status",
          "createdAt",
          "note",
          "known"
        ],
        "additionalProperties": false
      },
      "Parcel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "carrier": {
            "type": "string",
            "minLength": 1
          },
          "tracking": {
            "type": "string"
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "volumes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "status": {
            "enum": [
              "Na portaria",
              "Retirada"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "receivedBy": {
            "type": "string",
            "minLength": 1
          },
          "withdrawnAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "unit",
          "carrier",
          "tracking",
          "location",
          "volumes",
          "status",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "Invite": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "host": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "Visita",
              "Serviço"
            ]
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "credentialId": {
            "type": "string",
            "minLength": 1
          },
          "cancelled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "unit",
          "host",
          "type",
          "startsAt",
          "endsAt",
          "code",
          "credentialId",
          "cancelled"
        ],
        "additionalProperties": false
      },
      "Credential": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "enum": [
              "Morador",
              "Visitante",
              "Prestador"
            ]
          },
          "faceRef": {
            "type": "string",
            "minLength": 1
          },
          "plate": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "validFrom": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": "string",
